# Caddy 2.8+. All values come from a PRIVATE server environment, never GitHub.
{$OFFICE_WORKER_HOST} {
    header {
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Cache-Control no-store
    }
    handle_path /desktop/* {
        @foreignSocket {
            header Upgrade websocket
            not header Origin {$OFFICE_WORKER_ORIGIN}
        }
        respond @foreignSocket 403
        basic_auth {
            {$OFFICE_DESKTOP_USER} {$OFFICE_DESKTOP_PASSWORD_HASH}
        }
        reverse_proxy 127.0.0.1:6080 {
            header_up -Authorization
        }
    }
    @api path /neurobro/status /neurobro/login /neurobro/check /snapshot
    handle @api {
        reverse_proxy 127.0.0.1:8787
    }
    handle {
        respond 404
    }
}
