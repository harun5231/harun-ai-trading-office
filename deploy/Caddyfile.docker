{$OFFICE_WORKER_HOST} {
    header {
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Cache-Control no-store
    }
    @api path /health /robot/status /office/status /robot/settings
    handle @api {
        reverse_proxy worker:8787
    }
    handle {
        respond 404
    }
}
